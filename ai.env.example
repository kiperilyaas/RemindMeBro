# Which AI Remind Me Bro uses.
# The real file is data/ai.env (never in git, never in the zip). The Run & Go writes it the first time,
# asking for the Gemini key. To change AI: edit data/ai.env and restart the app.

# gemini | openrouter | omniroute | openai | custom | ollama (= only the local AI, nothing leaves the computer)
AI_PROVIDER=gemini

# API key of the service. Gemini: https://aistudio.google.com/apikey  (OmniRoute on this computer: can stay empty)
AI_API_KEY=

# Models. Empty = the default of the provider (Gemini: gemini-3.8-flash and gemini-3.5-flash-lite).
# OpenRouter, OmniRoute, OpenAI and custom need AI_MODEL (e.g. OpenRouter "google/gemini-3.8-flash").
AI_MODEL=
# quicker/cheaper model used to find deadlines in messages (empty = same as AI_MODEL)
AI_MODEL_FAST=

# Address of the API, only for "custom" or to override a preset (any OpenAI-compatible /v1 address).
# Examples:  OmniRoute http://127.0.0.1:20128/v1   OpenRouter https://openrouter.ai/api/v1
AI_BASE_URL=

# When the external AI does not answer (no internet, quota over): use Ollama if it is running
AI_FALLBACK_OLLAMA=true
# Thinking models: low = quicker answers (empty = do not send it)
AI_REASONING_EFFORT=low
